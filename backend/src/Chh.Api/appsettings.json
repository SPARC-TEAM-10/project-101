{
  "_secrets": "No secrets in this file. Connection strings, JWT signing key, SMS gateway key, FCM server key and maps API key are resolved from Azure Key Vault at runtime (api-standards.md §5, db-standards.md §5). The empty values below are placeholders that Key Vault / user-secrets override.",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=CHH;Username=postgres;Password=Pass@123",
    "HangfireDatabase": ""
  },
  "KeyVault": {
    "VaultUri": ""
  },
  "Fast2Sms": {
    "ApiKey": "sample-sms-api-key",
    "BaseUrl": "https://www.fast2sms.com/"
  },
  "Encryption": {
    "HealthDataKeyBase64": ""
  },
  "Jwt": {
    "Issuer": "chh-api",
    "Audience": "chh-clients",
    "AccessTokenLifetimeMinutes": 60
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "Enrich": [ "FromLogContext", "WithThreadId", "WithProcessId", "WithMachineName" ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/chh-api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
